{
  "expo": {
    "name": "Students Life",
    "slug": "students-life",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.students.life",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Students Life uses your photo library so you can choose and upload a profile photo, an applicant photo, or admission documents such as a passport, transcript, or certificate.",
        "NSPhotoLibraryAddUsageDescription": "Students Life may save selected images while you prepare profile photos and admission documents for your application."
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.students.life",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiBaseUrl": "https://www.stud-life.com/api/v1",
      "managerSlApiBaseUrl": "https://www.stud-life.com/manager-api/api/client/v1",
      "eas": {
        "projectId": "7787dd53-8b3a-404a-ab14-10ee7bc45df2"
      }
    }
  }
}
